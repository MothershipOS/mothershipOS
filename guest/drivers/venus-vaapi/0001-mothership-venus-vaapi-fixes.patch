+/*
+ * Decoded frames arrive in the V4L2 CAPTURE mapping, which virtio-media maps
+ * write-combined (uncached): reads from it are latency-bound per core, so a
+ * 4K NV12 frame takes ~13 ms on one thread. Split the rows over a few threads;
+ * uncached read bandwidth scales with the number of readers. The client syncs
+ * each surface right after submitting it, so this copy is on its critical path.
+ */
+#define VENUS_COPY_THREADS 4
+
+struct plane_copy {
+    uint8_t *destination;
+    const uint8_t *source;
+    uint32_t destination_stride;
+    uint32_t source_stride;
+    size_t destination_uv_offset;
+    size_t source_uv_offset;
+    uint32_t row_bytes;
+    unsigned int height;
+};
+
+struct plane_copy_slice {
+    const struct plane_copy *job;
+    unsigned int index;
+    unsigned int count;
+};
+
+static void *copy_planes_slice(void *opaque)
+{
+    const struct plane_copy_slice *slice = opaque;
+    const struct plane_copy *job = slice->job;
+    /* Total rows: luma height plus chroma height/2; slice them evenly. */
+    unsigned int total = job->height + job->height / 2u;
+    unsigned int first = (unsigned int)((uint64_t)total * slice->index / slice->count);
+    unsigned int last = (unsigned int)((uint64_t)total * (slice->index + 1) / slice->count);
+    unsigned int row;
+
+    for (row = first; row < last; row++) {
+        if (row < job->height)
+            memcpy(job->destination + (size_t)row * job->destination_stride,
+                   job->source + (size_t)row * job->source_stride,
+                   job->row_bytes);
+        else
+            memcpy(job->destination + job->destination_uv_offset +
+                       (size_t)(row - job->height) * job->destination_stride,
+                   job->source + job->source_uv_offset +
+                       (size_t)(row - job->height) * job->source_stride,
+                   job->row_bytes);
+    }
+    return NULL;
+}
+
+static void copy_planes_parallel(const struct plane_copy *job)
+{
+    struct plane_copy_slice slices[VENUS_COPY_THREADS];
+    pthread_t threads[VENUS_COPY_THREADS];
+    bool started[VENUS_COPY_THREADS] = { false };
+    unsigned int count = VENUS_COPY_THREADS;
+    unsigned int index;
+
+    /* Small frames are not worth the thread start-up. */
+    if ((size_t)job->row_bytes * job->height < 2u * 1024u * 1024u)
+        count = 1;
+
+    for (index = 0; index < count; index++)
+        slices[index] = (struct plane_copy_slice) {
+            .job = job, .index = index, .count = count,
+        };
+    for (index = 1; index < count; index++)
+        started[index] = pthread_create(&threads[index], NULL,
+                                        copy_planes_slice,
+                                        &slices[index]) == 0;
+    copy_planes_slice(&slices[0]);
+    for (index = 1; index < count; index++) {
+        if (started[index])
+            pthread_join(threads[index], NULL);
+        else
+            copy_planes_slice(&slices[index]);
+    }
+}
