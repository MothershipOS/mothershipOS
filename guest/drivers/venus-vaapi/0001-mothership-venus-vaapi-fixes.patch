+static struct gbm_device *venus_gbm_device(void)
+{
+    static struct gbm_device *device;
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+
+    pthread_mutex_lock(&lock);
+    if (!device) {
+        int fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+
+        if (fd >= 0) {
+            device = gbm_create_device(fd);
+            if (!device)
+                close(fd);
+        }
+    }
+    pthread_mutex_unlock(&lock);
+    return device;
+}
+
+/*
+ * Allocate NV12 surface storage as a GBM buffer. On the phone the render node
+ * is virtio-gpu (host freedreno via native context), so the bare-metal
+ * MSM_GEM_NEW ioctl returns EINVAL; GBM works on virtio-gpu and real MSM alike.
+ * The buffer is linear and CPU-mappable (decode copy still works) and a proper
+ * GPU resource (clients import it for zero-copy display). GBM may widen the
+ * stride, so the caller adopts the returned stride/layout.
+ */
+static int allocate_gbm_dmabuf(size_t want_stride, size_t scanlines,
+                               size_t chroma_scanlines, size_t *out_stride,
+                               size_t *out_uv_offset, size_t *out_size,
+                               int *dma_fd)
+{
+    struct gbm_device *device = venus_gbm_device();
+    struct gbm_bo *bo;
+    size_t rows;
+    size_t stride;
+    int fd;
+
+    if (!device)
+        return -ENODEV;
+    if (want_stride == 0 || want_stride > UINT32_MAX)
+        return -EOVERFLOW;
+    rows = scanlines + chroma_scanlines + 16u;
+    if (rows == 0 || rows > UINT32_MAX)
+        return -EOVERFLOW;
+
+    bo = gbm_bo_create(device, (uint32_t)want_stride, (uint32_t)rows,
+                       GBM_FORMAT_R8,
+                       GBM_BO_USE_LINEAR | GBM_BO_USE_RENDERING);
+    if (!bo)
+        return -ENOMEM;
+
+    stride = gbm_bo_get_stride(bo);
+    fd = gbm_bo_get_fd(bo);
+    gbm_bo_destroy(bo);
+    if (fd < 0)
+        return -EIO;
+    if (stride < want_stride)
+        stride = want_stride;
+    if (rows != 0 && stride > SIZE_MAX / rows) {
+        close(fd);
+        return -EOVERFLOW;
+    }
+
+    *out_stride = stride;
+    *out_uv_offset = stride * scanlines;
+    *out_size = stride * rows;
+    *dma_fd = fd;
+    return 0;
+}
