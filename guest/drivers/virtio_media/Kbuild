# in the guest kernel: CONFIG_MSHIP_VIRTIO_MEDIA; out of tree (M=): a module
obj-$(or $(CONFIG_MSHIP_VIRTIO_MEDIA),m) += virtio-media.o
virtio-media-y := scatterlist_builder.o virtio_media_ioctls.o virtio_media_driver.o
# out of tree (PixelOS's GKI): the stock config leaves CONFIG_VIRTIO_DMA_SHARED_BUFFER unset, Cuttlefish loads
# virtio_dma_buf.ko (its exports' CRCs: virtio_dma_buf.symvers) -> DMABUF buffers as virtio objects
ifeq ($(CONFIG_MSHIP_VIRTIO_MEDIA),)
ccflags-y += -DCONFIG_VIRTIO_DMA_SHARED_BUFFER_MODULE=1
endif
