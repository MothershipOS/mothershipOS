# mothershipOS: the stock virtio-gpu driver of the guest kernel (drivers/gpu/drm/virtio), patched, as a module
obj-m += virtio-gpu.o
virtio-gpu-y := virtgpu_drv.o virtgpu_kms.o virtgpu_gem.o virtgpu_vram.o \
	virtgpu_display.o virtgpu_vq.o \
	virtgpu_fence.o virtgpu_object.o virtgpu_debugfs.o virtgpu_plane.o \
	virtgpu_ioctl.o virtgpu_prime.o virtgpu_trace_points.o virtgpu_submit.o
# Cuttlefish builds it with KMS (virtual_device_core.fragment); the GKI config does not know the option
ccflags-y += -DCONFIG_DRM_VIRTIO_GPU_KMS=1
