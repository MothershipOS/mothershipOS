diff -ruN a/sway/server.c b/sway/server.c
--- a/sway/server.c	2025-06-08 23:09:07.000000000 +0200
+++ b/sway/server.c	2026-10-18 15:30:00.000000000 +0200
@@ -82,11 +82,17 @@
 	 * more logic here. */
 
 	struct wlr_drm_lease_request_v1 *req = data;
+	// mothershipOS: remember the leased output by name (lease_output <name> off revokes only that lease)
+	char *name = req->n_connectors > 0 && req->connectors[0]->output ?
+		strdup(req->connectors[0]->output->name) : NULL;
 	struct wlr_drm_lease_v1 *lease = wlr_drm_lease_request_v1_grant(req);
 	if (!lease) {
 		sway_log(SWAY_ERROR, "Failed to grant lease request");
 		wlr_drm_lease_request_v1_reject(req);
+		free(name);
+		return;
 	}
+	lease->data = name;	// a few bytes per lease, kept for the session
 }
 #endif
 
