+/// mothershipOS: the event queue and guest memory (kept by process_event), for jack events from the jack watcher
+static EVENT_QUEUE: std::sync::Mutex<Option<(VringRwLock, GuestMemoryAtomic<GuestMemoryMmap>)>> =
+    std::sync::Mutex::new(None);
+
+/// Post one event (VIRTIO_SND_EVT_*) into a buffer the guest gave the event queue; false if there is none yet.
+fn post_event(code: u32, data: u32) -> bool {
+    let guard = EVENT_QUEUE.lock().unwrap();
+    let Some((vring, atomic_mem)) = guard.as_ref() else {
+        return false;
+    };
+    let mem = atomic_mem.memory();
+    let chain = match vring.get_mut().get_queue_mut().iter(atomic_mem.memory()) {
+        Ok(mut it) => it.next(),
+        Err(_) => None,
+    };
+    let Some(chain) = chain else {
+        return false;
+    };
+    let Ok(mut writer) = chain.clone().writer(&mem) else {
+        return false;
+    };
+    let event = VirtioSoundEvent { hdr: VirtioSoundHeader { code: code.into() }, data: data.into() };
+    if writer.write_obj(event).is_err() {
+        return false;
+    }
+    let len = writer.bytes_written() as u32;
+    if vring.add_used(chain.head_index(), len).is_err() {
+        return false;
+    }
+    let _ = vring.signal_used_queue();
+    true
+}
+
+/// mothershipOS: the jacks from MSHIP_SOUND_JACKS, `<nid>:hp` or `<nid>:mic` separated by commas (nid = the stream
+/// whose PCM the jack belongs to), as HDA pin configurations, so the guest's driver makes "Headphone" / "Mic" jacks
+fn jacks_from_env() -> Vec<(VirtioSoundJackInfo, &'static str)> {
+    let Ok(spec) = std::env::var("MSHIP_SOUND_JACKS") else {
+        return vec![];
+    };
+    spec.split(',')
+        .filter_map(|j| {
+            let (nid, kind) = j.split_once(':')?;
+            let nid: u32 = nid.trim().parse().ok()?;
+            // pin default config: jack (31:30 = 0), device (23:20: 2 = headphone out, 0xa = mic in), 1/8" mini
+            // (19:16 = 1), association 1; caps: presence detect (bit 2) + output (bit 4) / input (bit 5)
+            let (device, caps, name) = match kind.trim() {
+                "hp" => (0x2u32, 0x14u32, "hp"),
+                "mic" => (0xa, 0x24, "mic"),
+                _ => return None,
+            };
+            let mut info = VirtioSoundJackInfo::default();
+            info.hdr.hda_fn_nid = nid.into();
+            info.hda_reg_defconf = ((device << 20) | (1 << 16) | (1 << 4)).into();
+            info.hda_reg_caps = caps.into();
+            Some((info, name))
+        })
+        .collect()
+}
+
+/// Watch $HOME/jacks (`hp=0|1 mic=0|1`, written by the host) and post jack events when a jack changes.
+fn watch_jacks(jacks: Arc<RwLock<Vec<VirtioSoundJackInfo>>>, names: Vec<&'static str>) {
+    let Some(home) = std::env::var_os("HOME") else {
+        return;
+    };
+    let path = std::path::Path::new(&home).join("jacks");
+    std::thread::spawn(move || loop {
+        std::thread::sleep(std::time::Duration::from_millis(250));
+        let state = std::fs::read_to_string(&path).unwrap_or_default();
+        for (id, name) in names.iter().enumerate() {
+            let want = state.split_whitespace().any(|kv| kv == format!("{name}=1")) as u8;
+            let have = jacks.read().unwrap()[id].connected;
+            if want == have {
+                continue;
+            }
+            let code = if want == 1 { VIRTIO_SND_EVT_JACK_CONNECTED } else { VIRTIO_SND_EVT_JACK_DISCONNECTED };
+            // the state the guest sees follows the events it got: retried until the guest has an event buffer
+            if post_event(code, id as u32) {
+                jacks.write().unwrap()[id].connected = want;
+            }
+        }
+    });
+}
