-            let Some(request) = stream.requests.front_mut() else {
-                return 0;
-            };
-            if !matches!(stream.state, PCMState::Start) {
+        // snd_pcm_writei: plugin devices (the PipeWire ALSA plugin) keep their ring moving with it; alsa-lib's mmap
+        // emulation took one buffer and then never saw room again
+        let mut lck = streams.write().unwrap();
+        let stream = &mut lck[stream_id];
+        let Some(request) = stream.requests.front_mut() else {
+            return Ok(false);
+        };
+        if !matches!(stream.state, PCMState::Start) {
+            stream.requests.pop_front();
+            return Ok(false);
+        }
+        let room = usize::try_from(p.frames_to_bytes(avail)).unwrap_or_default();
+        let mut buf = vec![0u8; std::cmp::min(room, request.len() - request.pos)];
+        let read_bytes = match request.read_output(&mut buf) {
+            Ok(v) => v as usize,
+            Err(err) => {
+                log::error!("Could not read TX request, dropping it immediately: {err}");
                 stream.requests.pop_front();
-                return 0;
+                return Ok(false);
             }
-
-            let n_bytes = std::cmp::min(buf.len(), request.len() - request.pos);
