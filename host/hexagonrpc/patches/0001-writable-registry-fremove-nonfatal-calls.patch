 #include <string.h>
@@ -32,7 +33,14 @@
 #include "iobuffer.h"
 #include "listener.h"
 
+/* writable files: handles from WFD_BASE, real file descriptors */
+#define WFD_BASE 0x10000
+#define WFD_MAX 32
+
+const char *apps_std_persist_dir;
+
 struct apps_std_ctx {
+	int wfds[WFD_MAX];
 	int rootfd;
 	int adsp_avs_cfg_dirfd;
 	int adsp_library_dirfd;
@@ -46,6 +54,93 @@
 };
 
 /*
+ * A remote path in the persist registry -> its file in apps_std_persist_dir: "<persist>/sensors/registry/registry/<f>"
+ * -> "<dir>/registry/<f>", "<persist>/sensors/registry/sns_reg_version" -> "<dir>/sns_reg_version" (<persist> is
+ * /persist or /mnt/vendor/persist; "." and ".." are resolved). Anything else: -1.
+ */
+static int persist_path(const char *remote, char *out, size_t size)
+{
+	char norm[512], seg[128];
+	const char *p = remote, *rest;
+	size_t n = 0;
+
+	if (apps_std_persist_dir == NULL || remote[0] != '/')
+		return -1;
+	norm[0] = 0;
+	while (*p) {
+		size_t len;
+
+		while (*p == '/')
+			p++;
+		len = strcspn(p, "/");
+		if (len == 0)
+			break;
+		if (len >= sizeof(seg))
+			return -1;
+		memcpy(seg, p, len);
+		seg[len] = 0;
+		p += len;
+		if (!strcmp(seg, "."))
+			continue;
+		if (!strcmp(seg, "..")) {
+			char *slash = strrchr(norm, '/');
+
+			if (slash == NULL)
+				return -1;
+			*slash = 0;
+			n = slash - norm;
+			continue;
+		}
+		if (n + 1 + len + 1 > sizeof(norm))
+			return -1;
+		norm[n++] = '/';
+		memcpy(norm + n, seg, len + 1);
+		n += len;
+	}
+	rest = norm;
+	if (!strncmp(rest, "/mnt/vendor", 11))
+		rest += 11;
+	if (!strcmp(rest, "/persist/sensors/registry/sns_reg_version"))
+		return snprintf(out, size, "%s/sns_reg_version", apps_std_persist_dir) < (int) size ? 0 : -1;
+	if (!strncmp(rest, "/persist/sensors/registry/registry/", 35) && rest[35] && !strchr(rest + 35, '/'))
+		return snprintf(out, size, "%s/registry/%s", apps_std_persist_dir, rest + 35) < (int) size ? 0 : -1;
+	return -1;
+}
+
+static int wfd_index(struct apps_std_ctx *ctx, uint32_t handle)
+{
+	if (handle < WFD_BASE || handle >= WFD_BASE + WFD_MAX || ctx->wfds[handle - WFD_BASE] < 0)
+		return -1;
+	return handle - WFD_BASE;
+}
+
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	int i = wfd_index(ctx, *fd);
+	ssize_t ret;
+
+	if (i < 0)
+		return AEE_EBADPARM;
+	ret = write(ctx->wfds[i], inbufs[1].p, inbufs[1].s);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write: %s\n", strerror(errno));
+		return AEE_EFAILED;
+	}
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+/*
  * This is a placeholder function used to complete any I/O operations.
  * File descriptors do not have a flush operation because their reads and
  * writes are blocking.
@@ -71,7 +166,15 @@
 {
 	struct apps_std_ctx *ctx = data;
 	const uint32_t *first_in = inbufs[0].p;
-	int ret;
+	int ret, i;
+
+	i = wfd_index(ctx, *first_in);
+	if (i >= 0) {
+		ret = fsync(ctx->wfds[i]);
+		close(ctx->wfds[i]);
+		ctx->wfds[i] = -1;
+		return ret ? AEE_EFAILED : 0;
+	}
 
 	ret = hexagonfs_close(ctx->fds, *first_in);
 	if (ret) {
@@ -167,9 +270,24 @@
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
 	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+		char path[640];
+		int i;
+
+		if (persist_path(inbufs[3].p, path, sizeof(path))) {
+			fprintf(stderr, "Tried to open %s for writing\n",
+					(const char *) inbufs[3].p);
+			return AEE_EUNSUPPORTED;
+		}
+		for (i = 0; i < WFD_MAX && ctx->wfds[i] >= 0; i++);
+		if (i == WFD_MAX)
+			return AEE_ENOMEMORY;
+		ctx->wfds[i] = open(path, O_WRONLY | O_CREAT | O_CLOEXEC | (rw_mode == 'a' ? O_APPEND : O_TRUNC), 0644);
+		if (ctx->wfds[i] < 0) {
+			fprintf(stderr, "Could not open %s for writing: %s\n", path, strerror(errno));
+			return AEE_EFAILED;
+		}
+		*out = WFD_BASE + i;
+		return 0;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -207,6 +325,28 @@
 	return 0;
 }
 
+/* The sensors' registry removes files it is about to rewrite (in the writable persist copy, -w). */
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	char path[640];
+
+	if (inbufs[1].s == 0 || ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (persist_path(inbufs[1].p, path, sizeof(path))) {
+		fprintf(stderr, "Ignoring remove of %s\n", (const char *) inbufs[1].p);
+		return 0;
+	}
+	if (unlink(path) && errno != ENOENT) {
+		fprintf(stderr, "Could not remove %s: %s\n", path, strerror(errno));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
+
 static uint32_t apps_std_opendir(void *data,
 				 const struct fastrpc_io_buffer *inbufs,
 				 struct fastrpc_io_buffer *outbufs)
@@ -365,6 +505,9 @@
 
 	memcpy(iface, &apps_std_interface, sizeof(struct fastrpc_interface));
 
+	for (int i = 0; i < WFD_MAX; i++)
+		ctx->wfds[i] = -1;
+
 	ctx->rootfd = hexagonfs_open_root(ctx->fds, root);
 	if (ctx->rootfd < 0)
 		goto err_free_ctx;
@@ -419,7 +562,10 @@
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -444,7 +590,10 @@
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fremove_def,
+		.impl = apps_std_fremove,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{
 		.def = &apps_std_opendir_def,
