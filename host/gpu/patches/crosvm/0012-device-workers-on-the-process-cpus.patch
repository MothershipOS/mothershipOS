+/// The CPUs the process may run on, recorded before the vCPU threads pin themselves.
+static PROCESS_AFFINITY: std::sync::OnceLock<Vec<usize>> = std::sync::OnceLock::new();
+
+/// Records the calling thread's CPU affinity as the process's, once. The vCPU threads call it before pinning
+/// themselves: devices are activated from a vCPU thread (the guest's register write) and a thread inherits its
+/// creator's affinity, so without this every device worker would share one vCPU's CPUs.
+pub fn record_process_affinity() {
+    #[cfg(any(target_os = "android", target_os = "linux"))]
+    if let Ok(cpus) = crate::get_cpu_affinity() {
+        let _ = PROCESS_AFFINITY.set(cpus);
+    }
+}
