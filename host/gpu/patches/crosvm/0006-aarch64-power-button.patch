+/// Instantiates a VirtioInputConfig object for a power button: KEY_POWER only.
+pub fn new_power_button_config() -> VirtioInputConfig {
+    let mut supported_events: BTreeMap<u16, virtio_input_bitmap> = BTreeMap::new();
+    supported_events.insert(EV_KEY, virtio_input_bitmap::from_bits(&[KEY_POWER]));
+    VirtioInputConfig::new(
+        virtio_input_device_ids::new(0, 0, 0, 0),
+        "Crosvm Power Button".to_string(),
+        "virtio-power-button".to_string(),
+        virtio_input_bitmap::new([0u8; 128]),
+        supported_events,
+        BTreeMap::new(),
+    )
+}
