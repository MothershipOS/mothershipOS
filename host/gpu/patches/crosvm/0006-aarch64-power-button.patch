+/// The host end of the power button device (see [`create_power_button_device`]), taken by the VM's
+/// [`PowerButton`] once the VM is built.
+#[cfg(target_arch = "aarch64")]
+pub static POWER_BUTTON: std::sync::Mutex<Option<UnixStream>> = std::sync::Mutex::new(None);
+
+/// aarch64 VMs have no ACPI power button: a virtio-input device with KEY_POWER only, so `crosvm
+/// powerbtn` asks the guest to shut down as on x86 (the guest's input stack sees a power key).
+#[cfg(target_arch = "aarch64")]
+pub fn create_power_button_device(protection_type: ProtectionType) -> DeviceResult {
+    let (device_end, host_end) = UnixStream::pair().context("power button socket")?;
+    let dev = virtio::input::new_power_button(device_end, virtio::base_features(protection_type))
+        .context("failed to set up power button")?;
+    *POWER_BUTTON.lock().unwrap() = Some(host_end);
+    Ok(VirtioDeviceStub {
+        dev: Box::new(dev),
+        jail: None,
+    })
+}
+
+/// The VM's power button (`crosvm powerbtn`): a press and release of KEY_POWER on the power button
+/// device.
+#[cfg(target_arch = "aarch64")]
+pub struct PowerButton(pub UnixStream);
+
+#[cfg(target_arch = "aarch64")]
+impl vm_control::PmResource for PowerButton {
+    fn pwrbtn_evt(&mut self) {
+        use std::io::Write;
+        // struct virtio_input_event: type, code (le16), value (le32)
+        let event = |typ: u16, code: u16, value: i32| {
+            let mut b = [0u8; 8];
+            b[0..2].copy_from_slice(&typ.to_le_bytes());
+            b[2..4].copy_from_slice(&code.to_le_bytes());
+            b[4..8].copy_from_slice(&value.to_le_bytes());
+            b
+        };
+        const EV_SYN: u16 = 0;
+        const EV_KEY: u16 = 1;
+        const KEY_POWER: u16 = 116;
+        let mut events = Vec::new();
+        for (typ, code, value) in [(EV_KEY, KEY_POWER, 1), (EV_SYN, 0, 0), (EV_KEY, KEY_POWER, 0), (EV_SYN, 0, 0)] {
+            events.extend(event(typ, code, value));
+        }
+        if let Err(e) = self.0.write_all(&events) {
+            error!("power button: {}", e);
+        }
+    }
+}
