+/// PSCI SYSTEM_SUSPEND (DEN0022 5.19), the guest's suspend-to-RAM: the caller is the only vCPU still on. Set it
+/// up as PSCI resumes a CPU (6.4.3): at the entry point (x1) with the context id (x2) in x0, EL1h with interrupts
+/// masked, MMU and data cache off. It runs again when the VM is resumed.
+#[cfg(target_arch = "aarch64")]
+fn psci_system_suspend(vcpu: &dyn VcpuArch) -> Result<()> {
+    use hypervisor::VcpuRegAArch64::*;
+    let entry = vcpu.get_one_reg(X(1))?;
+    let context = vcpu.get_one_reg(X(2))?;
+    let sctlr = vcpu.get_one_reg(System(aarch64_sys_reg::SCTLR_EL1))?;
+    vcpu.set_one_reg(Pc, entry)?;
+    vcpu.set_one_reg(X(0), context)?;
+    vcpu.set_one_reg(Pstate, 0x3c5)?; // EL1h, DAIF masked
+    vcpu.set_one_reg(System(aarch64_sys_reg::SCTLR_EL1), sctlr & !(1 | 1 << 2))?; // M, C off
+    Ok(())
+}
+
+/// mothershipOS: the guest suspended itself, so the host puts the VM to sleep (mothershipd `vm.sleep`: devices
+/// back to the host, display off, woken by a key, a click or the Wake button, which resumes it). The VM is the
+/// directory mothershipOS started it in (MSHIP_VM_DIR).
+#[cfg(target_arch = "aarch64")]
+fn mship_vm_sleep() {
+    let Some(vm) = std::env::var_os("MSHIP_VM_DIR")
+        .and_then(|d| std::path::Path::new(&d).file_name().map(|n| n.to_string_lossy().into_owned()))
+    else {
+        return;
+    };
+    thread::spawn(move || {
+        let req = format!("{{\"id\":1,\"op\":\"vm.sleep\",\"vm\":\"{}\"}}\n", vm);
+        let r = std::os::unix::net::UnixStream::connect("/run/mothership/mothershipd.sock").and_then(|mut s| {
+            s.write_all(req.as_bytes())?;
+            let mut reply = [0u8; 256];
+            s.read(&mut reply).map(|_| ())
+        });
+        if let Err(e) = r {
+            error!("mothershipd: vm.sleep {}: {}", vm, e);
+        }
+    });
+}
