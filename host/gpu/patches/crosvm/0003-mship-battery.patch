diff --git a/power_monitor/src/mship.rs b/power_monitor/src/mship.rs
new file mode 100644
index 000000000..10e0af806
--- /dev/null
+++ b/power_monitor/src/mship.rs
@@ -0,0 +1,132 @@
+// mothershipOS (host/gpu/patch-crosvm-battery.py): battery state from the host's mship-battery service.
+//
+// One line per update on a Unix stream socket, `key=value` separated by spaces, e.g.
+// `ac=1 present=1 status=charging percent=9 voltage=3932362 current=1025390 charge_counter=450000
+// charge_full=5000000 temp=375 health=good` (µV, µA with + = charging, µAh, 0.1 °C). Unknown keys are ignored.
+
+use std::error::Error;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::os::unix::net::UnixStream;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use base::AsRawDescriptor;
+use base::Event;
+use base::ReadNotifier;
+
+use crate::BatteryData;
+use crate::BatteryStatus;
+use crate::PowerData;
+use crate::PowerMonitor;
+
+pub const DEFAULT_SOCKET: &str = "/run/mothership/battery.sock";
+
+pub struct MshipMonitor {
+    event: Event,
+    latest: Arc<Mutex<Option<PowerData>>>,
+}
+
+impl MshipMonitor {
+    pub fn connect() -> std::result::Result<Box<dyn PowerMonitor>, Box<dyn Error>> {
+        let path =
+            std::env::var("MSHIP_BATTERY_SOCK").unwrap_or_else(|_| DEFAULT_SOCKET.to_string());
+        let event = Event::new()?;
+        let signal = event.try_clone()?;
+        let latest = Arc::new(Mutex::new(None));
+        let shared = latest.clone();
+        // the reader thread survives service restarts; the battery worker only waits on `event`
+        std::thread::Builder::new()
+            .name("mship_battery".into())
+            .spawn(move || loop {
+                if let Ok(stream) = UnixStream::connect(&path) {
+                    for line in BufReader::new(stream).lines() {
+                        let Ok(line) = line else { break };
+                        if let Some(data) = parse(&line) {
+                            *shared.lock().unwrap() = Some(data);
+                            let _ = signal.signal();
+                        }
+                    }
+                }
+                std::thread::sleep(Duration::from_secs(2));
+            })?;
+        Ok(Box::new(MshipMonitor { event, latest }))
+    }
+}
+
+impl ReadNotifier for MshipMonitor {
+    fn get_read_notifier(&self) -> &dyn AsRawDescriptor {
+        &self.event
+    }
+}
+
+impl PowerMonitor for MshipMonitor {
+    fn read_message(&mut self) -> std::result::Result<Option<PowerData>, Box<dyn Error>> {
+        self.event.wait()?;
+        Ok(self.latest.lock().unwrap().take())
+    }
+}
+
+// Linux POWER_SUPPLY_HEALTH_* (the guest's goldfish_battery driver passes the register through)
+fn health(v: &str) -> u32 {
+    match v {
+        "good" => 1,
+        "overheat" => 2,
+        "dead" => 3,
+        "over-voltage" => 4,
+        "unspecified-failure" => 5,
+        "cold" => 6,
+        "watchdog-timer-expire" => 7,
+        "safety-timer-expire" => 8,
+        "over-current" => 9,
+        "calibration-required" => 10,
+        "warm" => 11,
+        "cool" => 12,
+        "hot" => 13,
+        _ => 0,
+    }
+}
+
+fn parse(line: &str) -> Option<PowerData> {
+    let mut ac_online = false;
+    let mut present = true;
+    let mut b = BatteryData {
+        status: BatteryStatus::Unknown,
+        percent: 0,
+        voltage: 0,
+        current: 0,
+        charge_counter: 0,
+        charge_full: 0,
+        temperature: 0,
+        health: 0,
+    };
+    for kv in line.split_whitespace() {
+        let (k, v) = kv.split_once('=')?;
+        match k {
+            "ac" => ac_online = v == "1",
+            "present" => present = v == "1",
+            "status" => {
+                b.status = match v {
+                    "charging" => BatteryStatus::Charging,
+                    "discharging" => BatteryStatus::Discharging,
+                    "not-charging" => BatteryStatus::NotCharging,
+                    "full" => BatteryStatus::Full,
+                    _ => BatteryStatus::Unknown,
+                }
+            }
+            "percent" => b.percent = v.parse::<u32>().ok()?.min(100),
+            "voltage" => b.voltage = v.parse().ok()?,
+            "current" => b.current = v.parse::<i32>().ok()? as u32,
+            "charge_counter" => b.charge_counter = v.parse().ok()?,
+            "charge_full" => b.charge_full = v.parse().ok()?,
+            "temp" => b.temperature = v.parse().ok()?,
+            "health" => b.health = health(v),
+            _ => {}
+        }
+    }
+    Some(PowerData {
+        ac_online,
+        battery: present.then_some(b),
+    })
+}
