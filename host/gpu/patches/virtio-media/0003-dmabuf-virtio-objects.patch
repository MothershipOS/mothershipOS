+/// mothershipOS: resolves a virtio object (e.g. a virtio-gpu buffer) to a host DMABUF.
+pub type VirtioObjectResolver = Box<dyn Fn(&crate::ioctl::VirtioObjectId) -> Option<OwnedFd> + Send>;
+
+/// mothershipOS: the host DMABUFs of a `DMABUF` buffer's planes, from their virtio objects. The host device takes
+/// its own reference at QBUF/PREPARE_BUF, the returned fds can be closed after it.
+fn guest_objects_to_host(
+    host_buffer: &mut V4l2Buffer,
+    objects: &[crate::ioctl::VirtioObjectId],
+    resolver: Option<&VirtioObjectResolver>,
+) -> anyhow::Result<Vec<OwnedFd>> {
+    use std::os::fd::AsRawFd;
+    let mut fds = vec![];
+    if let V4l2PlanesWithBackingMut::DmaBuf(planes) = host_buffer.planes_with_backing_iter_mut() {
+        let resolver = resolver.ok_or_else(|| anyhow::anyhow!("DMABUF buffer, but no virtio object resolver"))?;
+        for (i, mut plane) in planes.enumerate() {
+            let object = objects.get(i).ok_or_else(|| anyhow::anyhow!("DMABUF plane {i}: no virtio object"))?;
+            let fd = resolver(object).ok_or_else(|| anyhow::anyhow!("DMABUF plane {i}: unknown virtio object {object:02x?}"))?;
+            plane.set_fd(fd.as_raw_fd());
+            fds.push(fd);
+        }
+    }
+    Ok(fds)
+}
+
+/// mothershipOS: put the guest's fd values back into a `DMABUF` buffer returned by the host.
+fn restore_guest_fds(buffer: &mut V4l2Buffer, guest_buffer: &V4l2Buffer) {
+    let guest_fds: Vec<i32> = match guest_buffer.planes_with_backing_iter() {
+        v4l2r::ioctl::V4l2PlanesWithBacking::DmaBuf(planes) => planes.map(|p| p.fd()).collect(),
+        _ => return,
+    };
+    if let V4l2PlanesWithBackingMut::DmaBuf(planes) = buffer.planes_with_backing_iter_mut() {
+        for (mut plane, fd) in planes.zip(guest_fds) {
+            plane.set_fd(fd);
+        }
+    }
+}
