+/// mothershipOS: replace the host MMAP offsets of `buffer` (from session `session_id`) with the guest
+/// offsets the proxy registered for them.
+fn host_mmap_offsets_to_guest(
+    mmap_buffers: &BTreeMap<u32, V4l2MmapPlaneInfo>,
+    session_id: u32,
+    buffer: &mut V4l2Buffer,
+) {
+    let queue = buffer.queue();
+    let index = buffer.index() as u8;
+    if let V4l2PlanesWithBackingMut::Mmap(planes) = buffer.planes_with_backing_iter_mut() {
+        for (j, mut plane) in planes.enumerate() {
+            if let Some((&guest_offset, _)) = mmap_buffers.iter().find(|(_, b)| {
+                b.session_id == session_id && b.queue == queue && b.index == index && b.plane == j as u8
+            }) {
+                plane.set_mem_offset(guest_offset);
+            }
+        }
+    }
+}
+
