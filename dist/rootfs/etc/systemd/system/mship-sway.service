[Unit]
Description=mothershipOS host compositor (sway on the panel)
Requires=seatd.service
# not after systemd-user-sessions (it waits for the network): the session is a service with seatd, not a login.
# session-setup waits for the panel's KMS device and writes its card (WLR_DRM_DEVICES) and the sway settings
After=seatd.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=mship
WorkingDirectory=~
RuntimeDirectory=mship-wayland
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mship-wayland
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=LIBSEAT_BACKEND=seatd
# the boot logo fades out before sway takes the panel; the shell fades in once it is on screen (mship-system splash)
ExecStartPre=+/usr/local/sbin/mship-system session-setup
EnvironmentFile=-/run/mothership/sway/env
ExecStartPre=+/usr/local/sbin/mship-system splash-out
ExecStart=/usr/bin/sway
ExecStartPost=+/usr/local/sbin/mship-system splash-in
# VMs started from the shell run in this unit; the kernel OOM-killing one must not stop the whole session
OOMPolicy=continue
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
