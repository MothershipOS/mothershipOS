[Unit]
Description=mothershipOS host compositor (sway on DSI-1)
Requires=seatd.service
# not after systemd-user-sessions (it waits for the network): the session is a service with seatd, not a login;
# after the KMS device (WLR_DRM_DEVICES below) has registered (80-mship-drm-systemd.rules)
After=seatd.service getty@tty1.service dev-dri-card1.device
Wants=dev-dri-card1.device
Conflicts=getty@tty1.service

[Service]
User=mship
WorkingDirectory=~
RuntimeDirectory=mship-wayland
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mship-wayland
Environment=WLR_DRM_DEVICES=/dev/dri/card1
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=LIBSEAT_BACKEND=seatd
ExecStart=/usr/bin/sway
# VMs started from the shell run in this unit; the kernel OOM-killing one must not stop the whole session
OOMPolicy=continue
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
