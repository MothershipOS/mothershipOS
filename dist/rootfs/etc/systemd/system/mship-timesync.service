[Unit]
Description=Set the clock from an HTTP Date header, directly or via the dev PC proxy (mothershipOS)
After=network.target systemd-networkd.service
Wants=network.target

[Service]
# exec, not oneshot: the boot (and mothershipd after multi-user.target) must not wait for the network; the clock is
# already restored from the RTC offset
Type=exec
ExecStart=/usr/local/sbin/mship-system timesync
